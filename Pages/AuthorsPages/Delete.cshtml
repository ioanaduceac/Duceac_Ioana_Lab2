@page "{id:int}"
@model Duceac_Ioana_Lab2.Pages.AuthorsPages.DeleteModel

@{
    ViewData["Title"] = "Delete Author";
}

<h1>Delete Author</h1>

<h3>Are you sure you want to delete this author?</h3>
<hr />

<div>
    <dl class="row">
        <dt class="col-sm-3">First Name</dt>
        <dd class="col-sm-9">@Model.Authors.FirstName</dd>

        <dt class="col-sm-3">Last Name</dt>
        <dd class="col-sm-9">@Model.Authors.LastName</dd>
    </dl>

    <form method="post">
        <input type="hidden" asp-for="Authors.ID" />

        <div asp-validation-summary="All" class="text-danger"></div>

        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="./Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
