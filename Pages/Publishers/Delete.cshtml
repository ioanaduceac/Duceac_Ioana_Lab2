@page "{id:int}"
@model Duceac_Ioana_Lab2.Pages.Publishers.DeleteModel

<h1>Delete Publisher</h1>

<h3>Are you sure you want to delete this publisher?</h3>

<dl class="row">
    <dt class="col-sm-2">ID</dt>
    <dd class="col-sm-10">@Model.Publisher.ID</dd>

    <dt class="col-sm-2">Publisher Name</dt>
    <dd class="col-sm-10">@Model.Publisher.PublisherName</dd>
</dl>

<form method="post">
    <input type="hidden" name="id" value="@Model.Publisher.ID" />

    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-page="Index" class="btn btn-secondary">Cancel</a>
</form>
