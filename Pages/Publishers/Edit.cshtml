@page "{id:int}"
@model Duceac_Ioana_Lab2.Pages.Publishers.EditModel

<h1>Edit Publisher</h1>

<form method="post">
    <input type="hidden" asp-for="Publisher.ID" />

    <div class="mb-3">
        <label asp-for="Publisher.PublisherName" class="form-label"></label>
        <input asp-for="Publisher.PublisherName" class="form-control" />
        <span asp-validation-for="Publisher.PublisherName"
              class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-page="Index" class="btn btn-secondary">Back to List</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
