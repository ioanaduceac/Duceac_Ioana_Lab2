@page "{id:int?}"
@model Duceac_Ioana_Lab2.Pages.Publishers.IndexModel

<h1>Publishers</h1>

<p>
    <a asp-page="Create" class="btn btn-primary">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Publisher Name</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Publishers)
        {
            <tr>
                <td>@item.ID</td>
                <td>@item.PublisherName</td>
                <td>
                    <a asp-page="./Index" asp-route-id="@item.ID">Select</a> |
                    <a asp-page="Edit" asp-route-id="@item.ID">Edit</a> |
                    <a asp-page="Details" asp-route-id="@item.ID">Details</a> |
                    <a asp-page="Delete" asp-route-id="@item.ID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
@if (Model.PublisherData.Books != null)
{
    <h3>Books Edited by Selected Publisher</h3>

    <table class="table">
        <tbody>
            @foreach (var b in Model.PublisherData.Books)
            {
                <tr>
                    <td>@b.title</td>
                    <td>@b.Authors?.FullName</td>
                </tr>
            }
        </tbody>
    </table>
}

