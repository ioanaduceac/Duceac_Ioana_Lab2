@page "{id:int?}"
@model Duceac_Ioana_Lab2.Pages.CategoryPages.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Category[0].CategoryName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Category[0].BookCategories)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.CategoryData.Categories)
        {
            string selectedRow = "";

            <tr class="@selectedRow">
                <td>
                    @Html.DisplayFor(modelItem => item.CategoryName)
                </td>
                <td>
                    <a asp-page="./Index" asp-route-id="@item.ID">Select</a> |
                    <a asp-page="./Edit" asp-route-id="@item.ID">Edit</a> |
                    <a asp-page="./Details" asp-route-id="@item.ID">Details</a> |
                    <a asp-page="./Delete" asp-route-id="@item.ID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.CategoryData.BookCategories != null)
{
    <h3>Books in Selected Category</h3>
    <table class="table">
        <tr>
            <th>Book Title</th>
            <th>Author</th>
        </tr>
        @foreach (var item in Model.CategoryData.BookCategories)
        {
            <tr>
                <td>
                    @item.Book.title
                </td>
                <td>
                    @item.Book.Authors.FullName
                </td>
            </tr>
        }
    </table>
}